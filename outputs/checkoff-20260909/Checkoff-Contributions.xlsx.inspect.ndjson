{"kind":"table","sheet":"Guide","address":"A1:B39","rows":39,"cols":2,"values":[[null,null],["Checkoff contributions",null],[null,null],["Capacity","500 contribution rows, one member/product allocation per row."],["Total contributions",0],["Currency","Use the same currency as the credit batch. No currency symbols in import amounts."],[null,null],["Field","What to enter"],["Department","Employer department or ministry from the deduction schedule."],["Payroll Number","Use the member identifier held in Customer Reference 3 for normal matching. Keep leading zeros."],["Contribution","Amount being remitted for this member and product. Enter a number with a decimal point, e.g. 2500.00."],["Product Balance","Numeric product balance from the schedule. Required by the parser; use 0 only if that is the correct value."],["Beneficiary","Member / beneficiary name from the schedule."],["Product Credit Code","Existing numeric loan or investment product Code in the system; not the account number or product name."],["Entry Type","Select the exact, case-sensitive code from the dropdown. See the meanings below."],["Your Reference","Your reconciliation reference, e.g. the employer and deduction month."],[null,null],["Entry Type","Allocation used by the importer"],["sLoan","Loan principal repayment."],["sInterest","Loan interest repayment."],["sLoanInterest","Combined loan repayment; the system splits principal and interest using loan recovery settings."],["sShare","Share contribution through the configured investment product."],["sInvest","Investment contribution through the configured investment product."],["sRisk / wCont / wLoan","These codes use the investment-product matching branch. Confirm your product mapping before choosing one."],[null,null],["Example only","A member remits 12,000: enter a 10,000 loan row and a separate 2,000 shares row."],["Loan row","Use the actual member identifier, loan product code and sLoanInterest if the 10,000 includes interest."],["Shares row","Repeat the member identifier and use the actual shares product code with sShare."],[null,null],["Upload steps","Complete the Checkoff Import sheet starting in row 2. Amber cells are editable."],["1. Review","Reconcile Total contributions above to the employer remittance and the credit batch total."],["2. Export","Save a copy of Checkoff Import as CSV UTF-8 (comma delimited). Export that sheet only."],["3. Keep the layout","Keep row 1 as the only header and exactly eight columns in this order. Do not add totals or notes."],["4. Remove unused rows","The CSV must contain only the header and completed rows. Remove empty records before upload."],["5. Import","Open the Pending credit batch, select Check-Off and upload the CSV. Review unmatched entries."],["6. Complete processing","Verify and authorize through the usual batch workflow, then confirm entry posting results."],[null,null],["Source","SwiftFinancialz2: CreditBatchAppService.cs, ParseCreditBatchImport / ParseCheckOff; Enumerations.cs, CheckOffEntryType."],["Scope","Template follows the local source as inspected on 9 September 2026. No real member data is included."]]}
